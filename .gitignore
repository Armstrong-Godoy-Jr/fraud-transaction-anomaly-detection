# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables / secrets
.env
*.env.local
secrets.yaml

# Data (raw/processed data not committed by default — see data/README if added)
data/raw/*.csv
data/raw/*.parquet
data/processed/*.csv
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model artifacts
*.pkl
*.joblib
*.h5
models/artifacts/

# OS/editor
.DS_Store
.vscode/
.idea/

# Testing/coverage
.pytest_cache/
.coverage
htmlcov/

# Jupyter
*.ipynb_meta
